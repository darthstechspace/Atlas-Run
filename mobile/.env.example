# Atlas Run V2 — copy to .env and fill in your values

# NEVER commit .env or put sb_secret_* keys in the mobile app.

#

# MINIMUM FOR OFFLINE PLAY: leave everything blank — app works with local save.

# See FREE_SETUP.txt for the $0 setup guide.



# --- Optional: Supabase (free tier) — cloud save, friends, leaderboards ---

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...



# --- Google Maps (Android APK + iOS app) — same key for both platforms ---

EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Cloud Console: enable "Maps SDK for Android" AND "Maps SDK for iOS".
# Restrict the key: Android app com.atlasrun.app + iOS app com.atlasrun.app.
# Rebuild native apps after adding the key (EAS or expo prebuild). Expo Go on iPhone uses Apple Maps only.

# Optional cloud map style IDs (Map Styles in Google Cloud):

EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID_IOS=

EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID_ANDROID=



# --- EAS (store builds) — run `eas init` in mobile/ if not linked ---

EAS_PROJECT_ID=02bf57c4-f43f-4cbf-9ccd-e644893f93a7

# Privacy policy (required for App Store / Play Store).
# Host docs/privacy-policy.html at HTTPS — see mobile/legal/HOSTING.txt (GitHub Pages works).

EXPO_PUBLIC_PRIVACY_POLICY_URL=https://YOUR_GITHUB_USER.github.io/AtlasRun/privacy-policy.html



# --- EAS cloud builds: set Supabase + Maps keys as EAS env vars (recommended) ---

# npx eas-cli env:create --name EXPO_PUBLIC_SUPABASE_URL --value ... --environment development --environment preview --environment production --visibility sensitive --non-interactive --force

# npx eas-cli env:create --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value ... --environment development --environment preview --environment production --visibility sensitive --non-interactive --force

# npx eas-cli env:create --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY --value ... --environment development --environment preview --environment production --visibility sensitive --non-interactive --force



# --- Leave OFF unless you deploy nearby-landmarks + Places billing ---

# EXPO_PUBLIC_ENABLE_LANDMARKS_EDGE=true
